# Copy this file to .env and fill in real values. Never commit .env.

# --- Wallet (testnet-only) ---
# Generated by scripts/00_generate_wallet.py. This is the Ethereum (L1) keypair
# Paradex uses to deterministically derive your Starknet (L2) account.
L1_ADDRESS=
L1_PRIVATE_KEY=

# --- Network ---
# testnet | mainnet
PARADEX_ENV=testnet

# --- TLS (only needed on machines behind a corporate SSL-inspecting proxy) ---
# If plain `pip install` / https requests fail with CERTIFICATE_VERIFY_FAILED,
# generate corp-ca-bundle.pem (see README) and point these at it.
# SSL_CERT_FILE=./corp-ca-bundle.pem
# REQUESTS_CA_BUNDLE=./corp-ca-bundle.pem
